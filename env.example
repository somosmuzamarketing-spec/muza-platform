# Base de datos (SQLite para desarrollo local; usa Postgres en producción)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="genera_un_valor_aleatorio_largo"
NEXTAUTH_URL="http://localhost:3000"

# Cuenta admin inicial (usada por el seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="cambia-esta-clave"

# LiveKit (video llamadas) - crea cuenta gratis en https://livekit.io
LIVEKIT_URL="wss://tu-proyecto.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Stripe (pagos)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Notificaciones push (anuncio manual desde /admin)
# Genera el par con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hola@somosmuza.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
